<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Matches OcrUtils.csproj's WinRT-flavored TFM so its ProjectReference isn't
         implicitly downgraded; every other referenced component's lower/unversioned
         Windows TFM is backward-compatible with this one. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Allows building this Windows-targeted project from a non-Windows SDK host -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\sessionutils\SessionUtils.csproj" />
    <ProjectReference Include="..\src\ocrutils\OcrUtils.csproj" />
    <ProjectReference Include="..\src\terminalutils\TerminalUtils.csproj" />
    <ProjectReference Include="..\src\serviceutils\ServiceUtils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- NullService is its own standalone project in a subfolder; keep its sources
         (and generated obj/bin) out of the default SDK compile glob here. -->
    <Compile Remove="NullService\**\*.cs" />
    <Content Remove="NullService\**" />
  </ItemGroup>

</Project>
