<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ScreenCaptureAutomation</AssemblyName>
    <RootNamespace>ScreenCaptureAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Needed for System.Drawing.Bitmap/Graphics and the clipboard image APIs. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows building this Windows-targeted, WinForms-referencing project from a non-Windows SDK host. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Emit ScreenCaptureAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
