<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>CommandLineAutomation</AssemblyName>
    <RootNamespace>CommandLineAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Emit CommandLineAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets CommandLineUtils.Tests cover the internal allowlist/capture helpers -->
    <InternalsVisibleTo Include="CommandLineUtils.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its sources out of this DLL -->
    <Compile Remove="CommandLineUtils.Tests/**/*.cs" />
  </ItemGroup>

</Project>
