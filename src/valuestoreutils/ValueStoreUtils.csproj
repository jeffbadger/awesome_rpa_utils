<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ValueStoreAutomation</AssemblyName>
    <RootNamespace>ValueStoreAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ValueStoreUtils.Tests/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- README shown on the NuGet package page (PackageReadmeFile is set in Directory.Build.targets) -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
