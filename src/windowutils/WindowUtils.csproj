<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0-windows;net8.0-windows;net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WindowAutomation</AssemblyName>
    <RootNamespace>WindowAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Emit WindowAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets WindowUtils.Tests cover the internal regex-filter, display-state, and JSON helpers without a live desktop -->
    <InternalsVisibleTo Include="WindowUtils.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its sources out of this DLL -->
    <Compile Remove="WindowUtils.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- net48 has no System.Text.Json in the BCL; the package supplies it for the net48 build only. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- README shown on the NuGet package page (PackageReadmeFile set in Directory.Build.targets) -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
