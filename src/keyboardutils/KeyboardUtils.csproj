<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>KeyboardAutomation</AssemblyName>
    <RootNamespace>KeyboardAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Emit KeyboardAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internals to the unit-test project; exclude test sources from the DLL. -->
    <InternalsVisibleTo Include="KeyboardUtils.Tests" />
    <Compile Remove="KeyboardUtils.Tests/**/*.cs" />
  </ItemGroup>

</Project>
