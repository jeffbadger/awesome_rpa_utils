<Project>

  <!--
    NuGet packaging defaults, imported AFTER each csproj body so the conditions
    below can see $(TargetFrameworks) and the component csprojs' own settings.
    A pack-metadata PropertyGroup in Directory.Build.props would never fire:
    at props-evaluation time $(TargetFrameworks) is still unset. The version is
    supplied at pack time by scripts/Pack-NuGet.ps1 (-p:Version) so no version
    is hardcoded here.
  -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable Condition="'$(IsPackable)' == ''">true</IsPackable>
    <PackageId Condition="'$(PackageId)' == ''">AwesomeRpaUtils.$(AssemblyName)</PackageId>
    <Authors>Jeff Badger</Authors>
    <Copyright>Copyright © Jeff Badger</Copyright>
    <Description>Awesome RPA Utils component: $(AssemblyName). See the package README for the full method surface.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <!-- Shown on the package page; each component csproj packs its own README.md as the file. -->
    <PackageReadmeFile Condition="Exists('$(MSBuildProjectDirectory)/README.md')">README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/jeffbadger/awesome_rpa_utils</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    The reference assemblies for the net48 target (needed to compile .NET
    Framework projects on machines without the 4.8 targeting pack, e.g. a
    Linux dev host; windows-latest CI has the targeting pack preinstalled).
    Component projects carry a multi-TFM <TargetFrameworks> list; test
    projects target net10.0 only and never get this. PrivateAssets keeps it
    out of any produced nuspec.
  -->
  <ItemGroup Condition="'$(TargetFrameworks)' != '' and $(TargetFrameworks.Contains('net48')) and !$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>