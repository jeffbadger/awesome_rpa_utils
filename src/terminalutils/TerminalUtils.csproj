<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>TerminalAutomation</AssemblyName>
    <RootNamespace>TerminalAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Allows building this Windows-targeted project from a non-Windows SDK host -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Emit TerminalAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets TerminalUtils.Tests cover the internal AnsiReconstruction/FieldSplitting helpers -->
    <InternalsVisibleTo Include="TerminalUtils.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its sources out of this DLL -->
    <Compile Remove="TerminalUtils.Tests/**/*.cs" />
  </ItemGroup>

</Project>
