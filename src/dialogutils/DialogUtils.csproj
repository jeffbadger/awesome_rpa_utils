<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>DialogAutomation</AssemblyName>
    <RootNamespace>DialogAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Emit DialogAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets DialogUtils.Tests cover the internal StripAccessKeyMnemonic helper -->
    <InternalsVisibleTo Include="DialogUtils.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its sources out of this DLL -->
    <Compile Remove="DialogUtils.Tests/**/*.cs" />
  </ItemGroup>

</Project>
