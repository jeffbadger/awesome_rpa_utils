<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ServiceAutomation</AssemblyName>
    <RootNamespace>ServiceAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Allows building this Windows-targeted project from a non-Windows SDK host -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Emit ServiceAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- First NuGet dependency in this repo - see README's Notes & Caveats for why.
         ServiceController can query/start/stop/pause a service but has no method to
         change its startup type, which is why SetStartType uses a small amount of
         direct advapi32.dll P/Invoke instead. -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets ServiceUtils.Tests cover the internal TryToWin32StartType helper -->
    <InternalsVisibleTo Include="ServiceUtils.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its sources out of this DLL -->
    <Compile Remove="ServiceUtils.Tests/**/*.cs" />
  </ItemGroup>

</Project>
