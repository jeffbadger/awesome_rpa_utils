<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>UIAutomation</AssemblyName>
    <RootNamespace>UIAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Needed for System.Windows.Automation (AutomationElement and friends) -->
    <UseWPF>true</UseWPF>
    <!-- Allows building this Windows-targeted, WPF-referencing project from a non-Windows SDK host -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Emit UIAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets UIAutomation.Tests cover the internal TryToControlType helper -->
    <InternalsVisibleTo Include="UIAutomation.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its sources out of this DLL -->
    <Compile Remove="UIAutomation.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- net48 has no System.Text.Json in the BCL; the package supplies it for the net48 build only. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- README shown on the NuGet package page (PackageReadmeFile set in Directory.Build.props) -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
