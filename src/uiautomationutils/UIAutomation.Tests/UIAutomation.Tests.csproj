<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Unlike the other *.Tests projects, this one can only RUN on Windows (it mirrors a
         UIA component and references UIA types; the flowing Microsoft.WindowsDesktop.App
         runtime requirement cannot run on a non-Windows host). -->
    <AssemblyName>UIAutomation.Tests</AssemblyName>
    <RootNamespace>UIAutomation.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UIAutomationUtils.csproj" />
  </ItemGroup>

</Project>