<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WinEventAutomation</AssemblyName>
    <RootNamespace>WinEventAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Emit WinEventAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose internals to the unit-test project; exclude test sources from the DLL. -->
    <InternalsVisibleTo Include="WinEventUtils.Tests" />
    <Compile Remove="WinEventUtils.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- net48 has no System.Text.Json in the BCL; the package supplies it for the net48 build only. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- README shown on the NuGet package page (PackageReadmeFile set in Directory.Build.props) -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
