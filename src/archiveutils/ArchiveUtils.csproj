<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ArchiveAutomation</AssemblyName>
    <RootNamespace>ArchiveAutomation</RootNamespace>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Allows building this Windows-targeted project from a non-Windows SDK host -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Emit ArchiveAutomation.xml next to the DLL so the XML doc comments are consumable -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- net48 has no System.Text.Json in the BCL; the package supplies it for the net48 build only. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- net48 keeps ZipArchive/ZipFile in these framework assemblies; net5+ has them in the BCL. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets ArchiveUtils.Tests cover the internal ArchiveSafety/Crc32Core/ArchiveCore helpers -->
    <InternalsVisibleTo Include="ArchiveUtils.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives in a subfolder; keep its sources out of this DLL -->
    <Compile Remove="ArchiveUtils.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- README shown on the NuGet package page (PackageReadmeFile set in Directory.Build.targets) -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
